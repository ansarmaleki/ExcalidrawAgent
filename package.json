{
  "name": "excalidrawagent",
  "version": "1.0.0",
  "scripts": {
    "dev": "npm run check && npm run build:web && tsx main.ts",
    "build": "tsc -p tsconfig.build.json && npm run build:web",
    "build:web": "esbuild web/app.tsx --bundle --format=iife --jsx=automatic --conditions=production --loader:.woff2=file --loader:.woff=file --outfile=public/app.js --log-level=warning",
    "start": "node dist/main.js",
    "eval": "tsx evals/runEvals.ts",
    "score": "tsx evals/scoreRun.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx smoke.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "type": "module",
  "dependencies": {
    "@ai-sdk/openai": "^4.0.59",
    "@excalidraw/excalidraw": "^0.18.1",
    "ai": "^7.0.93",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.13",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "^7.0.2"
  }
}
